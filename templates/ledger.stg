// audit/LEDGER.md.  Rendered by tools/st4/Render.java from audit/ledger.tsv.
// Every number is length(...) of a list of ledger rows; none is stored.

main(m) ::= <<
<!-- GENERATED from $m.source$ by tools/st4/Render.java and templates/ledger.stg. Do not edit. -->
# Datum audit ledger

Single source of truth: [`$m.source$`](ledger.tsv), generated by `make audit`
from `audit/ledger.src` and the kernel's `Print Assumptions` output.
Every number on this page is a count of ledger rows.

- **QED** (positive results): $length(m.qed)$
- **QEX** (Qed-closed counterexamples): $length(m.qex)$, of which $length(m.repaired)$ repaired and $length(m.open)$ open

## Counts by level

| Level | QED | QEX | open |
|---|---:|---:|---:|
$m.levels:levelRow(); separator="\n"$
| **Total** | **$length(m.qed)$** | **$length(m.qex)$** | **$length(m.open)$** |

## Tiers

| Tier | Meaning | QED | QEX |
|---:|---|---:|---:|
$m.tiers:tierRow(); separator="\n"$

QEX entries must be Tier 0 or 1.

## Axioms in use

$if(m.axioms)$$axiomTable(m.axioms)$$else$No ledger entry depends on an axiom.$endif$

## QEX: counterexamples

$if(m.qex)$$qexTable(m.qex)$$else$None yet.$endif$

## QED: positive results

$if(m.qed)$$qedTable(m.qed)$$else$None yet.$endif$
>>

axiomTable(xs) ::= <<
| Axiom | Entries |
|---|---:|
$xs:axiomRow(); separator="\n"$
>>

qexTable(xs) ::= <<
| Counterexample | Level | Tier | Repairs |
|---|---|---:|---|
$xs:qexRow(); separator="\n"$
>>

qedTable(xs) ::= <<
| Theorem | Level | Tier | Assumptions |
|---|---|---:|---|
$xs:qedRow(); separator="\n"$
>>

levelRow(l) ::= "| $l.name$ | $length(l.qed)$ | $length(l.qex)$ | $length(l.open)$ |"

tierRow(t) ::= "| $t.tier$ | $t.label$ | $length(t.qed)$ | $length(t.qex)$ |"

axiomRow(a) ::= "| `$a.name$` | $length(a.users)$ |"

qexRow(e) ::= "| `$e.name$` | $e.level$ | $e.tier$ | $repairs(e)$ |"

qedRow(e) ::= "| `$e.name$` | $e.level$ | $e.tier$ | $assumptions(e)$ |"

repairs(e) ::= <%$if(e.open)$**open**$else$$e.repairs:code(); separator=", "$$endif$%>

assumptions(e) ::= <%$if(e.closed)$closed$else$$e.assumptions:code(); separator=", "$$endif$%>

code(x) ::= "`$x$`"
